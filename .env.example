# Enquiry form mailer — copy to .env.local and fill in.
# Three values, nothing else. NEVER commit the filled-in file.

# The sending mailbox. Also the SMTP login.
MAIL_USER=stutika@obiterlegal.in

# Its app password — for Gmail/Workspace, the 16-character one generated
# under the account's security settings with 2FA on. Not the login password.
MAIL_PASS=

# Where enquiries are delivered.
MAIL_TO=stutika@obiterlegal.in
