# Enquiry form mailer — copy to .env.local and fill in.
# Any SMTP provider works: Google Workspace / Gmail app password, Zoho, Brevo, SES.
# NEVER commit the filled-in file; .env.local is gitignored.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=stutika@obiterlegal.in
SMTP_PASS=

# Optional. Defaults: from = SMTP_USER, to = site.email in lib/content.ts
ENQUIRY_FROM_EMAIL=stutika@obiterlegal.in
ENQUIRY_TO_EMAIL=stutika@obiterlegal.in
